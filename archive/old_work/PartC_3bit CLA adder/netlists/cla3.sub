.include gates.sub

.subckt CLA3 cout s2 s1 s0 a2 a1 a0 b2 b1 b0 vdd gnd
* Generate Logic: Gi_bar = NAND2(ai,bi), Gi = INV(Gi_bar)
x1 g0_bar a0 b0 vdd gnd NAND2
x2 g0     g0_bar vdd gnd INV
x3 g1_bar a1 b1 vdd gnd NAND2
x4 g1     g1_bar vdd gnd INV
x5 g2_bar a2 b2 vdd gnd NAND2
x6 g2     g2_bar vdd gnd INV

* Propagate Logic: Pi = ai xor bi with four NAND2 each (P0 is S0 directly, since there is no carry-in)
* P0 = S0
x7  p0_n1 a0    b0    vdd gnd NAND2
x8  p0_n2 a0    p0_n1 vdd gnd NAND2
x9  p0_n3 b0    p0_n1 vdd gnd NAND2
x10 s0    p0_n2 p0_n3 vdd gnd NAND2
* P1
x11 p1_n1 a1    b1    vdd gnd NAND2
x12 p1_n2 a1    p1_n1 vdd gnd NAND2
x13 p1_n3 b1    p1_n1 vdd gnd NAND2
x14 p1    p1_n2 p1_n3 vdd gnd NAND2
* P2
x15 p2_n1 a2    b2    vdd gnd NAND2
x16 p2_n2 a2    p2_n1 vdd gnd NAND2
x17 p2_n3 b2    p2_n1 vdd gnd NAND2
x18 p2    p2_n2 p2_n3 vdd gnd NAND2

* Carry Logic (C1) = G0
* Carry Logic (C2) = G1 + P1.G0 = NAND2(G1_bar, NAND2(P1,G0))
x19 t1_bar p1     g0     vdd gnd NAND2
x20 c2     g1_bar t1_bar vdd gnd NAND2
* Carry Logic (C3) = (G2 + P2.G1) + (P2.P1).G0, every term from G/P only (no ripple through c2)
x21 t2_bar p2     g1     vdd gnd NAND2
x22 t3     g2_bar t2_bar vdd gnd NAND2
x23 p21    p2     p1     vdd gnd AND2
x24 t4     p21    g0     vdd gnd AND2
x25 cout   t3     t4     vdd gnd OR2

* Sum Logic: S1 = P1 xor G0, S2 = P2 xor C2 (four NAND2 each)
* S1
x26 s1_n1 p1    g0    vdd gnd NAND2
x27 s1_n2 p1    s1_n1 vdd gnd NAND2
x28 s1_n3 g0    s1_n1 vdd gnd NAND2
x29 s1    s1_n2 s1_n3 vdd gnd NAND2
* S2
x30 s2_n1 p2    c2    vdd gnd NAND2
x31 s2_n2 p2    s2_n1 vdd gnd NAND2
x32 s2_n3 c2    s2_n1 vdd gnd NAND2
x33 s2    s2_n2 s2_n3 vdd gnd NAND2
.ends CLA3
