* nmos_off replay of Datasets/data/nmos_off.csv (10000 rows), generated by make_replay.py
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.include ../../Datasets/netlists/22nm_HP.pm

Vd d 0 dc 0
Vg g 0 dc 0
Vs s 0 dc 0
Vb b 0 dc 0
M1 d g s b nmos L=22n W=44n

.control
set numdgt=12
shell rm -f nmos_off_replay.out
