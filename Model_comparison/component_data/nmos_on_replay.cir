altermod nmos ndep = 5.96665E+18
altermod nmos u0 = 0.0406553
altermod nmos xj = 6.77964E-09
option temp = 56.1498
op
let row = 0
let t_id = -i(vd)
let t_ig = -i(vg)
let t_is = -i(vs)
let t_ib = -i(vb)
let c_id = @m1[id]
let c_ibd = @m1[ibd]
