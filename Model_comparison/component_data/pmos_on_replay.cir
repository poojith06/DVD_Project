* pmos_on replay of Datasets/data/pmos_on.csv (10000 rows), generated by make_replay.py
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.include ../../Datasets/netlists/22nm_HP.pm

Vd d 0 dc 0
Vg g 0 dc 0
Vs s 0 dc 0
Vb b 0 dc 0
M1 d g s b pmos L=22n W=44n

.control
set numdgt=12
shell rm -f pmos_on_replay.out
